# Production settings for deploy/docker-compose.prod.yaml. PLACEHOLDERS ONLY: replace every value.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   chmod 600 deploy/.env.prod          # readable by its owner only; never commit it
#   docker compose -f deploy/docker-compose.prod.yaml --env-file deploy/.env.prod up -d --build
#
# Generate each secret with: openssl rand -hex 32   (hex: safe inside DATABASE_URL, no escaping needed)
# Values containing "change-me" are refused by Adminspace in production: it will not start until replaced.
# Optional settings: leave them commented out when unused. An empty value (VAR=) is passed as an empty
# string, which Adminspace refuses for URLs and SETUP_TOKEN.
# Every variable is documented in docs/DEPLOYMENT.md (Configuration).

# --- Public access (Caddy) -----------------------------------------------------------------
# DNS name of the back office. Must resolve to this host; ports 80 and 443 must be reachable for ACME.
ADMINSPACE_DOMAIN=admin.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.com
# acme (public certificate) or internal (Caddy's own CA, for tests and private networks).
TLS_MODE=acme
# Published ports of the proxy. Keep 80/443 in production (ACME needs them).
HTTP_PORT=80
HTTPS_PORT=443
# Only when HTTPS_PORT is not 443: the port as it appears in the browser, e.g. ":8443".
# ORIGIN_PORT_SUFFIX=

# --- Image ---------------------------------------------------------------------------------
# Tag built by "docker compose build" (or a registry image you pushed). Use one tag per release
# (e.g. adminspace:0.1.0) so that a rollback is "set the previous tag, up -d".
ADMINSPACE_IMAGE=adminspace:latest

# --- PostgreSQL ----------------------------------------------------------------------------
POSTGRES_USER=adminspace
POSTGRES_DB=adminspace
POSTGRES_PASSWORD=change-me-postgres-password-openssl-rand-hex-32

# --- Shared with WorkAdventure -------------------------------------------------------------
# Must be identical to ADMIN_API_TOKEN of WorkAdventure's play and back. 32+ characters.
ADMIN_API_TOKEN=change-me-admin-api-token-openssl-rand-hex-32
# Must be identical to ADMIN_SOCKETS_TOKEN of WorkAdventure's play (live list, live disconnection).
# ADMIN_SOCKETS_TOKEN=
# Docker network shared with WorkAdventure's play and back (docker network create --internal <name>).
WORKADVENTURE_ADMIN_NETWORK=workadventure-admin

# --- Secrets of this admin -----------------------------------------------------------------
# 32+ characters. Derives the encryption key of 2FA secrets: changing it invalidates every 2FA secret
# and recovery code (see docs/DEPLOYMENT.md, Secrets rotation). Back it up with the database.
APP_SECRET=change-me-app-secret-openssl-rand-hex-32
# First-run web setup at https://<domain>/setup. Prefer the CLI (docs/DEPLOYMENT.md); if you use the web
# setup, set 16+ random characters here, then remove the line and recreate the container.
# SETUP_TOKEN=

# --- Behaviour -----------------------------------------------------------------------------
DEFAULT_LOCALE=en-US
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_HOURS=168
SESSION_MAX_PER_ACCOUNT=20
# Force TOTP two-factor authentication on every back-office account (recommended in production).
REQUIRE_MFA=true
LOG_REQUESTS=true
# Configure an SMTP relay to send invitations, verification links and password resets.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=AdminSpace <no-reply@example.com>
# Request body limit of the Node server (CSV import needs 2M).
BODY_SIZE_LIMIT=2M
# Seconds adapter-node waits for in-flight requests on shutdown.
SHUTDOWN_TIMEOUT=20
# true when migrations are run separately (node build/cli/migrate.js), see docs/DEPLOYMENT.md (Upgrades).
SKIP_MIGRATIONS=false
# Built-in maps and furniture are shared with every organization by default.
SKIP_CATALOG_IMPORT=false
# Maximum database connections per AdminSpace process.
DB_POOL_MAX=10

# --- Rate limits (0 disables a limit) ------------------------------------------------------
RATE_LIMIT_ADMIN_API_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
RATE_LIMIT_MFA_PER_IP=30
RATE_LIMIT_SETUP_PER_IP=10
RATE_LIMIT_SENSITIVE_PER_ACCOUNT=20

# --- Initial connection to WorkAdventure (editable later in Platform > Instance settings) ----
# WORKADVENTURE_PLAY_URL=https://play.example.com
# Enable the "Edit map" launch from AdminSpace: same secret as WorkAdventure's SECRET_KEY.
# WORKADVENTURE_PLAYER_TOKEN_SECRET=
# Base URL of the pusher for /rooms, /message and the /ws/admin/rooms websocket. WorkAdventure's own
# reverse proxy routes /ws/ to the right port, so its public URL is the simplest choice.
# WORKADVENTURE_PUSHER_INTERNAL_URL=https://play.example.com
# WORKADVENTURE_MAP_STORAGE_PUBLIC_URL=https://play.example.com/map-storage
# WORKADVENTURE_MAP_STORAGE_INTERNAL_URL=https://play.example.com/map-storage
# WORKADVENTURE_MAP_STORAGE_API_TOKEN=
# Same value as map-storage's WEB_HOOK_API_TOKEN; map-storage's WEB_HOOK_URL is then
# http://adminspace:3000/hooks/map-storage (private network: the public proxy refuses /hooks).
# WORKADVENTURE_MAP_STORAGE_WEBHOOK_TOKEN=
# WORKADVENTURE_START_ROOM_URL=/@/acme/hq/lobby

# --- Resources -----------------------------------------------------------------------------
ADMINSPACE_MEMORY_LIMIT=512M
POSTGRES_MEMORY_LIMIT=1G
PROXY_MEMORY_LIMIT=256M
# NODE_OPTIONS=--max-old-space-size=384

# --- Integration Center (optional; docs/INTEGRATIONS.md lists every provider) ---------------
# Redirect URIs: https://<ADMINSPACE_DOMAIN>/integrations/oauth/<provider>/callback. Examples:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT=organizations
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# INTEGRATION_ALLOWED_PRIVATE_HOSTS=
