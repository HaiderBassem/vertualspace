{
  "schema": "adminspace.component/1",
  "key": "garden-terrace",
  "version": "1.0.0",
  "kind": "room_template",
  "name": "Garden terrace",
  "description": "An open-air room: a fountain at the end of the path, a pond, trees, a picnic table, benches, a hammock and a beanbag circle, with a video meeting zone at the picnic table and one among the beanbags.",
  "translations": {
    "fr-FR": {
      "name": "Jardin-terrasse",
      "description": "Une pièce à ciel ouvert : fontaine au bout de l’allée, bassin, arbres, table de pique-nique, bancs, hamac et cercle de poufs, avec une zone de visioconférence à la table de pique-nique et une parmi les poufs."
    },
    "de-DE": {
      "name": "Gartenterrasse",
      "description": "Ein Raum unter freiem Himmel: Brunnen am Ende des Weges, Teich, Bäume, Picknicktisch, Bänke, Hängematte und Sitzsack-Kreis, mit Videobesprechungszone am Picknicktisch und eine bei den Sitzsäcken."
    },
    "es-ES": {
      "name": "Jardín-terraza",
      "description": "Una sala al aire libre: fuente al final del camino, estanque, árboles, mesa de picnic, bancos, hamaca y círculo de pufs, con una zona de videoreunión en la mesa de picnic y otra entre los pufs."
    },
    "ar-SA": {
      "name": "حديقة شرفة",
      "description": "غرفة في الهواء الطلق: نافورة في نهاية الممر وبركة وأشجار وطاولة نزهة ومقاعد وأرجوحة ودائرة من الوسائد، مع منطقة اجتماع مرئي عند الطاولة وأخرى بين الوسائد."
    }
  },
