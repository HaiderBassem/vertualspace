{
  "schema": "adminspace.component/1",
  "key": "open-office",
  "version": "1.1.0",
  "kind": "room_template",
  "name": "Open office",
  "description": "Eight workstations in two rows, a meeting corner with a whiteboard, and a coffee point. Wood floor, windows on the north wall.",
  "translations": {
    "fr-FR": {
      "name": "Plateau de bureaux",
      "description": "Huit postes de travail sur deux rangées, un coin réunion avec tableau blanc et un point café. Parquet, fenêtres au nord."
    },
    "de-DE": {
      "name": "Großraumbüro",
      "description": "Acht Arbeitsplätze in zwei Reihen, eine Besprechungsecke mit Whiteboard und eine Kaffeeecke. Holzboden, Fenster im Norden."
    },
    "es-ES": {
      "name": "Oficina abierta",
      "description": "Ocho puestos en dos filas, un rincón de reuniones con pizarra y un punto de café. Suelo de madera, ventanas al norte."
    },
    "ar-SA": {
      "name": "مكتب مفتوح",
      "description": "ثماني محطات عمل في صفين، وركن اجتماعات مع سبورة، وركن للقهوة. أرضية خشبية ونوافذ في الجدار الشمالي."
    }
  },
  "category": "templates",
