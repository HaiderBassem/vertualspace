{
    "name": "adminspace",
    "version": "0.1.0",
    "private": true,
    "description": "Self-hosted administration back office and Admin API for WorkAdventure",
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "start": "node build/index.js",
        "typecheck": "svelte-kit sync && tsc --noEmit -p tsconfig.json",
        "svelte-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "pretty": "prettier --write .",
        "pretty-check": "prettier --check .",
        "test": "vitest",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
        "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
        "catalog:generate": "tsx scripts/catalog/generate.ts",
        "catalog:import": "tsx --env-file-if-exists=.env scripts/catalog-import.ts",
        "catalog:install": "tsx --env-file-if-exists=.env scripts/catalog-install.ts",
        "db:studio": "drizzle-kit studio",
        "superadmin:create": "tsx --env-file-if-exists=.env scripts/create-superadmin.ts",
        "retention:run": "tsx --env-file-if-exists=.env scripts/retention.ts",
        "contract:sync": "tsx --env-file-if-exists=.env scripts/sync-contract.ts",
        "contract:check": "tsx --env-file-if-exists=.env scripts/sync-contract.ts --check",
        "i18n:check": "tsx --env-file-if-exists=.env scripts/i18n-check.ts",
        "test:e2e": "tsx scripts/e2e-build.ts && playwright test",
        "test:e2e:report": "playwright show-report node_modules/.cache/adminspace-e2e/report"
    },
    "dependencies": {
        "@anatine/zod-openapi": "^2.2.8",
        "@node-rs/argon2": "^2.0.2",
        "drizzle-orm": "^0.45.4",
        "jose": "^6.2.3",
        "nodemailer": "10.0.15",
        "otpauth": "^9.5.2",
        "postgres": "^3.4.9",
        "ws": "^8.22.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.64.1",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^24.0.0",
        "@types/nodemailer": "^8.0.2",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.31.11",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.18.0",
        "globals": "^16.4.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.0.1",
        "svelte": "^5.55.9",
        "svelte-check": "^4.4.8",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.22.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.1.4",
        "vitest": "^4.1.7"
    }
}
