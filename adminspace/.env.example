# Copy to .env and adjust. Every variable is validated at startup (src/lib/server/config.ts).

# PostgreSQL connection (docker compose up -d db starts one on port 5433).
DATABASE_URL=postgres://adminspace:adminspace@localhost:5433/adminspace

# Public URL of this admin, used by SvelteKit for CSRF checks in production (adapter-node). Also the base of
# every link sent by email and of the component collection URLs written into WorkAdventure maps: it must be
# reachable by people's browsers. Never taken from the request's Host header.
ORIGIN=http://localhost:4000

# Maximum request body size accepted by the Node server (adapter-node), e.g. 512K, 2M. The CSV member
# import accepts up to 1 MB, so production deployments should set at least 2M. Default: 512K.
# Component packages (ZIP) accept up to 16 MB: set at least 20M if organizations upload components.
BODY_SIZE_LIMIT=2M
# Behind a reverse proxy, tell adapter-node where the client address is (otherwise audit entries,
# IP bans and rate limits see the proxy's address). Example for one trusted proxy:
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# --- Shared with WorkAdventure -------------------------------------------------------------
# Must be identical to ADMIN_API_TOKEN in WorkAdventure's .env (play and back).
# At least 32 characters; placeholder values (containing "change-me", or "123") are refused in production.
ADMIN_API_TOKEN=change-me-to-a-long-random-string
# Must be identical to ADMIN_SOCKETS_TOKEN given to WorkAdventure's play service (optional:
# enables the live list of connected people). At least 32 characters. Generate with: openssl rand -hex 32
ADMIN_SOCKETS_TOKEN=

# --- Secrets of this admin -----------------------------------------------------------------
# At least 32 characters. Used to pseudonymize identifiers and to derive the encryption key of 2FA
# secrets (HKDF). Changing it makes existing 2FA secrets and recovery codes unusable.
# Generate with: openssl rand -hex 32. Placeholder values are refused in production.
APP_SECRET=change-me-to-at-least-32-random-characters
# First-run web setup (/setup). When set, /setup asks for this token. In production, /setup is
# refused unless it is set: create the first superadmin with `npm run superadmin:create` instead.
# At least 16 characters. Remove it once the first account exists.
# SETUP_TOKEN=

# --- Behaviour -----------------------------------------------------------------------------
# BCP 47 locale used when the browser asks for no supported language (en-US, fr-FR, de-DE, es-ES, ar-SA).
DEFAULT_LOCALE=en-US
# Sessions end after SESSION_TTL_HOURS of inactivity, and SESSION_ABSOLUTE_HOURS after login in any case.
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_HOURS=168
# Active sessions kept per account; the oldest end beyond this number.
SESSION_MAX_PER_ACCOUNT=20
# Force every back-office account to set up TOTP two-factor authentication.
REQUIRE_MFA=false
# One JSON line per request on stdout (no query strings, no bodies).
LOG_REQUESTS=true

# --- Rate limits (shared by every instance through PostgreSQL; 0 disables a limit) ----------
# Admin API calls per client IP and minute. WorkAdventure is the only expected caller: keep it generous.
RATE_LIMIT_ADMIN_API_PER_MINUTE=600
# Login attempts per 15 minutes, per client IP and per targeted account.
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
# Second-factor attempts per 15 minutes and client IP (5 invalid codes also lock the second factor).
RATE_LIMIT_MFA_PER_IP=30
# First-run setup attempts per hour and client IP.
RATE_LIMIT_SETUP_PER_IP=10
# Sensitive account changes (password, 2FA, email) per 15 minutes and account.
RATE_LIMIT_SENSITIVE_PER_ACCOUNT=20

# --- Initial connection to WorkAdventure (editable later in Platform > Instance settings) ----
WORKADVENTURE_PLAY_URL=http://play.workadventure.localhost
# How this admin reaches the pusher's admin endpoints. Same as the play URL unless it runs in Docker.
WORKADVENTURE_PUSHER_INTERNAL_URL=http://play.workadventure.localhost
WORKADVENTURE_MAP_STORAGE_PUBLIC_URL=http://map-storage.workadventure.localhost
WORKADVENTURE_MAP_STORAGE_INTERNAL_URL=http://map-storage.workadventure.localhost
WORKADVENTURE_MAP_STORAGE_API_TOKEN=
# Token map-storage sends to AdminSpace's webhook (map-storage's WEB_HOOK_API_TOKEN, with
# WEB_HOOK_URL=<this server>/hooks/map-storage): rooms created inside WorkAdventure then appear here.
# Without it the webhook refuses every call. Also editable in Platform > Instance settings.
WORKADVENTURE_MAP_STORAGE_WEBHOOK_TOKEN=
WORKADVENTURE_START_ROOM_URL=/_/global/maps.workadventure.localhost/starter/map.json

# Path to a WorkAdventure checkout, for npm run contract:sync and npm run db:seed.
WORKADVENTURE_REPO=../workadventure

# --- Email (optional; nothing is pretended to be sent without it) -------------------------
# SMTP server for invitations, registration verification and password reset, e.g.
# smtps://user:password@smtp.example.com:465 or smtp://localhost:1025 (Mailpit, MailHog).
# Without it: invitation links are shown to the inviter, password reset by email is unavailable, and
# public registration needs "without email verification" to be chosen explicitly.
# SMTP_URL=
# MAIL_FROM=AdminSpace <no-reply@example.com>
# Lifetime of invitation links, in hours (default 7 days).
# INVITATION_TTL_HOURS=168
# More rate limits (0 disables): registrations per IP and hour, reset requests per IP and hour,
# invitations per organization and hour.
# RATE_LIMIT_REGISTRATION_PER_IP=10
# RATE_LIMIT_PASSWORD_RESET_PER_IP=10
# RATE_LIMIT_INVITATIONS_PER_ORGANIZATION=200
# Component changes per organization and hour, and storage for uploaded components (MB, 0 = no limit).
# RATE_LIMIT_COMPONENT_CHANGES_PER_ORGANIZATION=120
# COMPONENT_STORAGE_PER_ORGANIZATION_MB=200

# --- Background jobs ------------------------------------------------------------------------
# Changes made in WorkAdventure (map-storage uploads and map updates) run as durable, retried jobs.
# Keep the worker on in at least one instance (several instances share the queue safely).
# JOB_WORKER=true

# --- Integration Center (docs/INTEGRATIONS.md) ----------------------------------------------
# Each provider is offered once its variables are set (restart AdminSpace). Register this redirect URI at the provider:
#   {ORIGIN}/integrations/oauth/{provider}/callback   e.g. https://admin.example.com/integrations/oauth/google/callback
# Example values below are placeholders: never commit real secrets.
# Google Calendar (personal): Google Cloud console > Credentials > OAuth client ID (Web application).
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft 365 calendar (personal): Entra ID app registration (Web), delegated Calendars.ReadBasic, User.Read.
# MICROSOFT_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_OAUTH_CLIENT_SECRET=
# Tenant id or domain; "organizations" (default) accepts any work or school account.
# MICROSOFT_OAUTH_TENANT=organizations
# Slack (workspace notifications and personal status): bot scopes chat:write, chat:write.public, incoming-webhook;
# user scope users.profile:write. The signing secret verifies the Events API (/integrations/webhooks/slack).
# SLACK_CLIENT_ID=1234567890.1234567890
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# GitHub OAuth app (personal coding activity), scope read:user.
# GITHUB_OAUTH_CLIENT_ID=Ov23li0000000000
# GITHUB_OAUTH_CLIENT_SECRET=
# GitLab application (personal), scope read_user. Self-managed instances set their own base URL.
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# Notion public integration (pages to place in rooms).
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# Trello API key (read token, 30 days; add ORIGIN to the key's allowed origins).
# TRELLO_API_KEY=
# Miro app, scope boards:read.
# MIRO_CLIENT_ID=
# MIRO_CLIENT_SECRET=
# Spotify app (personal "now playing", opt-in). Redirect URIs must be https (or http://127.0.0.1:PORT).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Hosts that outgoing webhooks may reach although private (a self-hosted n8n), comma-separated; plain http is only
# accepted for them. Every other private, loopback or link-local address is refused.
# INTEGRATION_ALLOWED_PRIVATE_HOSTS=n8n.internal
# Automation API (/automation/v1) calls per token and minute (0 disables the limit).
# RATE_LIMIT_AUTOMATION_PER_TOKEN=60
