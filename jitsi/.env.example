# Jitsi Meet for WorkAdventure. Copy to .env (git ignores it: it holds secrets) and fill in the values marked <...>.

# ---- Where --------------------------------------------------------------------------------------------------------
# The address people reach Jitsi at (no https://). It must resolve to this server: a DNS record of yours, or
# jitsi.<ip with dashes>.sslip.io, which points at that address without any DNS work.
JITSI_DOMAIN=jitsi.185-215-167-145.sslip.io
PUBLIC_URL=https://jitsi.185-215-167-145.sslip.io
# The public IP of the server: the video bridge tells browsers to send media there.
JVB_ADVERTISE_IPS=185.215.167.145
# Where the configuration and the data of the containers are kept.
CONFIG=/opt/vertualspace/jitsi/config
# The Docker network of the server's Traefik (to publish the web container).
EDGE_NETWORK=erp_default
TZ=UTC
JITSI_IMAGE_VERSION=stable

# ---- Names inside Jitsi -------------------------------------------------------------------------------------------
# XMPP_DOMAIN must be JITSI_DOMAIN: WorkAdventure signs the tokens for it (its "sub" claim is the Jitsi address).
XMPP_DOMAIN=jitsi.185-215-167-145.sslip.io
XMPP_AUTH_DOMAIN=auth.jitsi.185-215-167-145.sslip.io
XMPP_MUC_DOMAIN=muc.jitsi.185-215-167-145.sslip.io
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.jitsi.185-215-167-145.sslip.io
XMPP_GUEST_DOMAIN=guest.jitsi.185-215-167-145.sslip.io
XMPP_SERVER=xmpp.meet.jitsi
XMPP_BOSH_URL_BASE=http://xmpp.meet.jitsi:5280
JVB_BREWERY_MUC=jvbbrewery
JICOFO_AUTH_USER=focus
JVB_AUTH_USER=jvb

# ---- Secrets (random values: openssl rand -hex 24) ----------------------------------------------------------------
JICOFO_AUTH_PASSWORD=<random>
JVB_AUTH_PASSWORD=<random>

# ---- Only WorkAdventure gets in: JWT authentication, no guests ----------------------------------------------------
ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt
# JWT_APP_ID is JITSI_ISS of WorkAdventure and JWT_APP_SECRET its SECRET_JITSI_KEY (set in WorkAdventure's .env.prod).
JWT_APP_ID=workadventure
JWT_APP_SECRET=<random>
JWT_ACCEPTED_ISSUERS=workadventure
JWT_ACCEPTED_AUDIENCES=jitsi

# ---- Web behind Traefik (it does the HTTPS) -----------------------------------------------------------------------
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
ENABLE_XMPP_WEBSOCKET=1
ENABLE_COLIBRI_WEBSOCKET=1
ENABLE_WELCOME_PAGE=0
ENABLE_PREJOIN_PAGE=0
ENABLE_P2P=1

# ---- Media --------------------------------------------------------------------------------------------------------
JVB_PORT=10000
JVB_TCP_HARVESTER_DISABLED=false
JVB_TCP_PORT=4443
JVB_TCP_MAPPED_PORT=4443
# The TURN server of WorkAdventure (coturn), for people whose network blocks the direct path. Its shared secret is
# TURN_STATIC_AUTH_SECRET of WorkAdventure's .env.prod.
TURN_HOST=jitsi.185-215-167-145.sslip.io
TURN_PORT=3478
TURN_TRANSPORT=udp
TURN_CREDENTIALS=<TURN_STATIC_AUTH_SECRET>
